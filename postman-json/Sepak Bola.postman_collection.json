    {
      "name": "a. CRUD",
      "item": [
        {
          "name": "Semua Player",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test script request GET: Semua Pemain",
                  "pm.test(\"Status code adalah 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response berupa array berisi minimal 3 pemain\", () => {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData).to.be.an(\"array\");",
                  "  pm.expect(jsonData.length).to.be.at.least(3);",
                  "});",
                  "",
                  "pm.test(\"Setiap pemain memiliki field id, nama, klub, posisi, dan nomorPunggung\", () => {",
                  "  const json = pm.response.json();",
                  "  json.forEach((p) => {",
                  "    pm.expect(p).to.include.keys(\"id\", \"nama\", \"klub\", \"posisi\", \"nomorPunggung\");",
                  "  });",
                  "});",
                  "",
                  "pm.test(\"Data pemain pertama bernama Fajar Ramadhan\", () => {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData[0].nama).to.eql(\"Fajar Ramadhan\");",
                  "});",
                  "",
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/players",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "players"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Tambah Player",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Data baru memiliki id dan nama sesuai kiriman', function () {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.status).to.eql('success');",
                  "  pm.expect(jsonData.data).to.have.property('id');",
                  "  pm.expect(jsonData.data.id).to.be.a('number');",
                  "  pm.expect(jsonData.data.nama).to.eql('Budi Santoso');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('playerId', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{api-key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/players",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "players"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 4,\n  \"nama\": \"Budi Santoso\",\n  \"klub\": \"Persija Jakarta\",\n  \"posisi\": \"gelandang\",\n  \"nomorPunggung\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
