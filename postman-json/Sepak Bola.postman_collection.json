                  "});",
                  "pm.test(\"Pemain yang dikembalikan adalah pemain yang baru ditambahkan\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.eql(Number(pm.environment.get(\"playerId\")));",
