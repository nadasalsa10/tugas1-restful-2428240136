        {
          "name": "Filter Player berdasarkan posisi",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Semua pemain hasil filter berposisi gelandang', function () {",
                  "  const jsonData = pm.response.json();",
                  "  const players = Array.isArray(jsonData) ? jsonData : jsonData.data;",
                  "  pm.expect(players).to.be.an('array');",
                  "  pm.expect(players.length).to.be.at.least(1);",
                  "  players.forEach(function (p) {",
                  "    pm.expect(p.posisi).to.eql('gelandang');",
                  "  });",
                  "});"
                ]
              }
            }
